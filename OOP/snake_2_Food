import pygame
import sys
import random

pygame.init()


class Snake:
    def __init__(self, x, y):
        self.segments = [(x - i * 20, y) for i in range(10)] 
        self.direction = 'RIGHT'
        self.color = (0, 255, 0)

    def move(self, food):
        """Encapsulated movement logic"""
        head_x, head_y = self.segments[0]

        if self.direction == 'RIGHT':
            head_x += 20
        elif self.direction == 'LEFT':
            head_x -= 20
        elif self.direction == 'UP':
            head_y -= 20
        elif self.direction == 'DOWN':
            head_y += 20
        
        new_head = (head_x, head_y)
        self.segments.insert(0, new_head)
        if abs(head_x - food.x) < 20 and abs(head_y - food.y) < 20:
            food.spawn()
        else:
            self.segments.pop()

        # Add new head, remove tail
        self.segments.insert(0, (head_x, head_y))
        self.segments.pop()

    def change_direction(self, new_direction):
        """Controlled access to direction"""
        # Prevent reversing directly
        opposites = {'UP': 'DOWN', 'DOWN': 'UP',
                     'LEFT': 'RIGHT', 'RIGHT': 'LEFT'}
        if new_direction != opposites.get(self.direction):
            self.direction = new_direction

    def draw(self, window):
        """Encapsulated drawing logic"""
        for segment in self.segments:
            pygame.draw.rect(window, self.color, (segment[0], segment[1], 20, 20), border_radius=4)

class Food:
    def __init__(self, width, height):
        self.width = width
        self.height = height
        self.color = (170, 0, 0)
        self.spawn()
    def spawn(self):
        self.x = random.randrange(0, self.width - 20, 10)
        self.y = random.randrange(0, self.height - 20, 10)
    def draw(self, window):
        pygame.draw.rect(window,self.color, (self.x, self.y, 20, 20), border_radius=10)
# Set up display
width, height = 640, 480
window = pygame.display.set_mode((width, height))
pygame.display.set_caption("Snake Game - OOP")
clock = pygame.time.Clock()

# Create a snake object
snake = Snake(width // 2, height // 2)

# Main loop
food = Food(width, height)
while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_UP:
                snake.change_direction('UP')
            elif event.key == pygame.K_DOWN:
                snake.change_direction('DOWN')
            elif event.key == pygame.K_LEFT:
                snake.change_direction('LEFT')
            elif event.key == pygame.K_RIGHT:
                snake.change_direction('RIGHT')

    snake.move(food)

    window.fill((5, 30, 15))
    food.draw(window)
    snake.draw(window)
    pygame.display.flip()
    clock.tick(20)  #FPS
